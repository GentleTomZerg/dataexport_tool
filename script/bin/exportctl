#!/usr/bin/env bash

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

source "$ROOT_DIR/lib/common/strict.sh"
source "$ROOT_DIR/lib/common/log.sh"
source "$ROOT_DIR/lib/config/properties.sh"
source "$ROOT_DIR/lib/export/profile.sh"
source "$ROOT_DIR/lib/export/job.sh"
source "$ROOT_DIR/lib/export/plan.sh"
source "$ROOT_DIR/lib/sql/render.sh"
source "$ROOT_DIR/lib/exec/db.sh"
source "$ROOT_DIR/lib/artifact/pipeline.sh"
source "$ROOT_DIR/lib/security/crypto.sh"

setup_shell

###############################################################################
# Argument Parsing
###############################################################################

args_require_value() {
  [[ $# -ge 2 && -n "${2:-}" && "${2:0:1}" != "-" ]]
}

args_validate_date() {
  [[ -z "$1" || "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]
}

parse_exportctl_args() {
  local cli_name="$1"
  local selectors_name="$2"
  shift 2 || true
  local -n _cli="$cli_name"
  local -n _selectors="$selectors_name"

  _cli[cmd]="${1:-}"
  [[ -n "${_cli[cmd]}" ]] || return 1
  shift || true

  _cli[subcmd]=""
  _cli[db_config]=""
  _cli[jobs_config]=""
  _cli[env_config]=""
  _cli[date]=""
  _cli[db_profile]=""
  _cli[password]=""
  _cli[key_file]=""
  _cli[password_file]=""
  _selectors=()

  case "${_cli[cmd]}" in
    validate|plan|run)
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --db-config)
            args_require_value "$@" || return 1
            _cli[db_config]="$2"
            shift 2
            ;;
          --jobs-config)
            args_require_value "$@" || return 1
            _cli[jobs_config]="$2"
            shift 2
            ;;
          --env-config)
            args_require_value "$@" || return 1
            _cli[env_config]="$2"
            shift 2
            ;;
          --date)
            args_require_value "$@" || return 1
            _cli[date]="$2"
            shift 2
            ;;
          -h|--help)
            return 1
            ;;
          *)
            _selectors+=("$1")
            shift
            ;;
        esac
      done
      [[ -n "${_cli[db_config]}" && -n "${_cli[jobs_config]}" ]] || return 1
      args_validate_date "${_cli[date]}" || return 1
      ;;
    password)
      _cli[subcmd]="${1:-}"
      [[ "${_cli[subcmd]}" == "encode" || "${_cli[subcmd]}" == "decode" ]] || return 1
      shift || true
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --db-config)
            args_require_value "$@" || return 1
            _cli[db_config]="$2"
            shift 2
            ;;
          --db-profile)
            args_require_value "$@" || return 1
            _cli[db_profile]="$2"
            shift 2
            ;;
          --password)
            args_require_value "$@" || return 1
            _cli[password]="$2"
            shift 2
            ;;
          --password-file)
            args_require_value "$@" || return 1
            _cli[password_file]="$2"
            shift 2
            ;;
          --key-file)
            args_require_value "$@" || return 1
            _cli[key_file]="$2"
            shift 2
            ;;
          *)
            return 1
            ;;
        esac
      done
      if [[ "${_cli[subcmd]}" == "encode" ]]; then
        [[ -n "${_cli[db_config]}" && -n "${_cli[db_profile]}" && -n "${_cli[password]}" && -n "${_cli[key_file]}" ]] || return 1
      else
        [[ -n "${_cli[password_file]}" && -n "${_cli[key_file]}" ]] || return 1
      fi
      ;;
    *)
      return 1
      ;;
  esac
}

###############################################################################
# CLI Usage
###############################################################################

usage() {
  cat <<'EOF'
Usage:
  exportctl validate --db-config FILE --jobs-config FILE [--env-config FILE] [job selectors...]
  exportctl plan --db-config FILE --jobs-config FILE [--env-config FILE] [--date YYYY-MM-DD] [job selectors...]
  exportctl run --db-config FILE --jobs-config FILE [--env-config FILE] [--date YYYY-MM-DD] [job selectors...]
  exportctl password encode --db-config FILE --db-profile NAME --password VALUE --key-file FILE
  exportctl password decode --password-file FILE --key-file FILE

Selectors:
  users orders

Exit codes:
  1 only for invalid CLI arguments.
  0 for all runtime outcomes; failures are logged and summarized.
EOF
}

###############################################################################
# Output Rendering
###############################################################################

print_plan() {
  local plan_name="$1"
  local -n _plan="$plan_name"
  printf 'DB_PROFILE=%s\n' "${_plan[db_profile]}"
  printf 'DB_TYPE=%s\n' "${_plan[db_type]}"
  printf 'DB_HOST=%s\n' "${_plan[db_host]}"
  printf 'DB_PORT=%s\n' "${_plan[db_port]}"
  printf 'TABLE=%s\n' "${_plan[table]}"
  printf 'COLUMNS=%s\n' "${_plan[columns]}"
  printf 'EXPORT_FILE=%s\n' "${_plan[export_file]}"
  printf 'FIELD_SEPARATOR=%s\n' "${_plan[field_separator]}"
  printf 'LINE_TERMINATOR=%s\n' "${_plan[line_terminator]}"
  printf 'SQL=%s\n' "${_plan[sql]}"
  printf '\n'
}

print_job_header() {
  local job_name="$1"
  printf '== Job: %s ==\n' "$job_name"
}

print_validate_ok() {
  printf 'STATUS=OK\n\n'
}

file_line_count() {
  local path="$1"
  awk 'END { print NR + 0 }' "$path"
}

file_byte_size() {
  local path="$1"
  wc -c <"$path" | tr -d '[:space:]'
}

init_runtime_context() {
  local run_date="$1"
  local out_name="$2"
  local -n _out="$out_name"
  local epoch month_start next_month_epoch next_month_first

  if [[ -z "$run_date" ]]; then
    run_date="$(date +%F)"
  fi

  _out[export_date]="$run_date"
  _out[today]="$run_date"

  if [[ "$(uname)" == "Darwin" ]]; then
    epoch="$(date -j -f "%Y-%m-%d" "$run_date" "+%s")"
    _out[yesterday]="$(date -r $((epoch - 86400)) "+%F")"
    _out[export_month]="$(date -r "$epoch" "+%Y-%m")"
    month_start="$(date -r "$epoch" "+%Y-%m-01")"
    _out[month_start]="$month_start"
    next_month_epoch="$(date -j -f "%Y-%m-%d" "$month_start" "+%s")"
    next_month_epoch=$((next_month_epoch + 32 * 86400))
    next_month_first="$(date -r "$next_month_epoch" "+%Y-%m-01")"
    _out[month_end]="$(date -r $(($(date -j -f "%Y-%m-%d" "$next_month_first" "+%s") - 86400)) "+%F")"
  else
    _out[yesterday]="$(date -d "$run_date -1 day" +%F)"
    _out[export_month]="$(date -d "$run_date" +%Y-%m)"
    _out[month_start]="$(date -d "$run_date" +%Y-%m-01)"
    _out[month_end]="$(date -d "${_out[month_start]} +1 month -1 day" +%F)"
  fi

  export EXPORT_DATE="${_out[export_date]}"
  export TODAY="${_out[today]}"
  export YESTERDAY="${_out[yesterday]}"
  export EXPORT_MONTH="${_out[export_month]}"
  export MONTH_START="${_out[month_start]}"
  export MONTH_END="${_out[month_end]}"
}

print_runtime_context() {
  local runtime_name="$1"
  local -n _runtime="$runtime_name"
  printf '== Runtime ==\n'
  printf 'EXPORT_DATE=%s\n' "${_runtime[export_date]}"
  printf 'TODAY=%s\n' "${_runtime[today]}"
  printf 'YESTERDAY=%s\n' "${_runtime[yesterday]}"
  printf 'EXPORT_MONTH=%s\n' "${_runtime[export_month]}"
  printf 'MONTH_START=%s\n' "${_runtime[month_start]}"
  printf 'MONTH_END=%s\n\n' "${_runtime[month_end]}"
}

export_env_properties() {
  local props_name="$1"
  local key

  while IFS= read -r key; do
    [[ "$key" == ENV_* ]] || continue
    export "$key=$(props_get "$props_name" "$key")"
  done < <(props_keys "$props_name" "ENV_")
}

print_env_properties() {
  local props_name="$1"
  local key
  local -a env_keys=()

  mapfile -t env_keys < <(props_keys "$props_name" "ENV_")
  if [[ "${#env_keys[@]}" -eq 0 ]]; then
    return 0
  fi

  printf '== Environment ==\n'
  for key in "${env_keys[@]}"; do
    [[ "$key" == ENV_* ]] || continue
    printf '%s=%s\n' "$key" "${!key:-}"
  done
  printf '\n'
}

resolve_job_selectors() {
  local props_name="$1"
  local selectors_name="$2"
  local out_name="$3"
  local -n _selectors="$selectors_name"
  local -n _out="$out_name"
  local selector job_name
  local -a all_jobs=()
  declare -A selected=()
  declare -A known=()

  mapfile -t all_jobs < <(list_export_jobs "$props_name")
  for job_name in "${all_jobs[@]}"; do
    known["$job_name"]=1
  done

  if [[ "${#_selectors[@]}" -eq 0 ]]; then
    _out=("${all_jobs[@]}")
    return 0
  fi

  for selector in "${_selectors[@]}"; do
    if [[ -n "${known[$selector]:-}" ]]; then
      selected["$selector"]=1
    else
      printf 'ERROR: unknown selector %s\n' "$selector" >&2
    fi
  done

  _out=()
  for job_name in "${!selected[@]}"; do
    _out+=("$job_name")
  done
  if [[ "${#_out[@]}" -gt 0 ]]; then
    mapfile -t _out < <(printf '%s\n' "${_out[@]}" | sort)
  fi
}

###############################################################################
# Config Loading And Job Processing
###############################################################################

load_all_properties() {
  local cli_name="$1"
  local props_name="$2"
  local -n _cli="$cli_name"
  local -n _props="$props_name"

  if [[ -n "${_cli[env_config]:-}" ]]; then
    load_props_from_file "${_cli[env_config]}" "$props_name"
    export_env_properties "$props_name"
  fi
  load_props_from_file "${_cli[db_config]}" "$props_name"
  load_props_from_file "${_cli[jobs_config]}" "$props_name"
}

summary_mark_ok() {
  local summary_name="$1"
  local job_name="$2"
  local -n _summary="$summary_name"
  _summary[total]=$((_summary[total] + 1))
  _summary[ok]=$((_summary[ok] + 1))
  log_job_ok "$job_name" "stage=complete"
}

summary_mark_failed() {
  local summary_name="$1"
  local job_name="$2"
  local -n _summary="$summary_name"
  _summary[total]=$((_summary[total] + 1))
  _summary[failed]=$((_summary[failed] + 1))
  if [[ -n "${_summary[failed_jobs]}" ]]; then
    _summary[failed_jobs]+=" "
  fi
  _summary[failed_jobs]+="$job_name"
}

print_summary() {
  local summary_name="$1"
  local -n _summary="$summary_name"
  printf 'SUMMARY total=%s ok=%s failed=%s\n' "${_summary[total]}" "${_summary[ok]}" "${_summary[failed]}"
  if [[ -n "${_summary[failed_jobs]}" ]]; then
    printf 'FAILED_JOBS=%s\n' "${_summary[failed_jobs]}"
  fi
}

build_job_plan() {
  local props_name="$1"
  local job_name="$2"
  local profile_name="$3"
  local job_out_name="$4"
  local plan_name="$5"

  build_export_plan "$props_name" "$job_name" "$profile_name" "$job_out_name" "$plan_name"
}

handle_validate_mode() {
  local summary_name="$1"
  local job_name="$2"

  print_validate_ok
  summary_mark_ok "$summary_name" "$job_name"
}

handle_plan_mode() {
  local plan_name="$1"
  local summary_name="$2"
  local job_name="$3"
  local -n _plan="$plan_name"

  print_plan "$plan_name"
  summary_mark_ok "$summary_name" "$job_name"
}

handle_run_mode() {
  local plan_name="$1"
  local profile_name="$2"
  local summary_name="$3"
  local job_name="$4"
  local -n _plan="$plan_name"
  local -n _profile="$profile_name"

  print_plan "$plan_name"

  log_job_info "$job_name" "stage=export_start db_type=${_plan[db_type]} file=${_plan[export_file]}"
  if ! execute_plan_export "$plan_name" "$profile_name"; then
    log_job_error "$job_name" "stage=export reason=db export failed"
    summary_mark_failed "$summary_name" "$job_name"
    return 0
  fi
  log_job_info "$job_name" "stage=export_ok file=${_plan[export_file]} lines=$(file_line_count "${_plan[export_file]}") bytes=$(file_byte_size "${_plan[export_file]}")"

  if ! run_artifact_pipeline "$plan_name"; then
    log_job_error "$job_name" "stage=artifact reason=post export pipeline failed"
    summary_mark_failed "$summary_name" "$job_name"
    return 0
  fi

  if [[ -n "${_plan[artifact_path]:-}" && -f "${_plan[artifact_path]}" ]]; then
    log_job_info "$job_name" "stage=artifact_ok file=${_plan[artifact_path]} bytes=$(file_byte_size "${_plan[artifact_path]}")"
  fi

  summary_mark_ok "$summary_name" "$job_name"
}

process_job() {
  local cli_name="$1"
  local props_name="$2"
  local job_name="$3"
  local summary_name="$4"
  local -n _cli="$cli_name"
  local -n _summary="$summary_name"
  local -A profile=()
  local -A job=()
  local -A plan=()

  print_job_header "$job_name"
  if ! build_job_plan "$props_name" "$job_name" profile job plan; then
    printf 'STATUS=FAILED\n\n'
    log_job_error "$job_name" "stage=plan reason=plan build failed"
    summary_mark_failed "$summary_name" "$job_name"
    return 0
  fi

  plan[sql]="$(render_select_sql plan)"

  if [[ "${_cli[cmd]}" == "validate" ]]; then
    handle_validate_mode "$summary_name" "$job_name"
    return 0
  fi

  if [[ "${_cli[cmd]}" == "plan" ]]; then
    handle_plan_mode plan "$summary_name" "$job_name"
    return 0
  fi

  handle_run_mode plan profile "$summary_name" "$job_name"
}

###############################################################################
# Command Flow
###############################################################################

run_export_command() {
  local cli_name="$1"
  local selectors_name="$2"
  local -n _cli="$cli_name"
  local -n _selectors="$selectors_name"
  local -A props=()
  local -A runtime=()
  local -A summary=()
  local -a selected_jobs=()
  local job_name

  init_runtime_context "${_cli[date]:-}" runtime
  load_all_properties "$cli_name" props
  resolve_job_selectors props "$selectors_name" selected_jobs
  summary[total]=0
  summary[ok]=0
  summary[failed]=0
  summary[failed_jobs]=""

  if [[ "${#selected_jobs[@]}" -eq 0 ]]; then
    log_error "no runnable jobs resolved"
    print_summary summary
    return 0
  fi

  print_runtime_context runtime
  print_env_properties props

  for job_name in "${selected_jobs[@]}"; do
    process_job "$cli_name" props "$job_name" summary
  done

  print_summary summary
  return 0
}

###############################################################################
# Password Commands
###############################################################################

run_password_command() {
  local cli_name="$1"
  local -n _cli="$cli_name"
  case "${_cli[subcmd]}" in
  encode)
    local -A props=()
    local -A profile=()
    load_props_from_file "${_cli[db_config]}" props
    load_export_profile props "${_cli[db_profile]}" profile || return 0
    profile[password_key_file]="${_cli[key_file]}"
    write_encrypted_password "${_cli[password]}" "$(profile_password_file props "${_cli[db_profile]}" profile)" profile
    ;;
  decode)
    local -A profile=()
    profile[password_key_file]="${_cli[key_file]}"
    decrypt_password_file "${_cli[password_file]}" profile
    ;;
  esac
}

###############################################################################
# Program Entrypoint
###############################################################################

main() {
  local -A cli=()
  local -a selectors=()

  if ! parse_exportctl_args cli selectors "$@"; then
    usage >&2
    exit 1
  fi

  case "${cli[cmd]}" in
  validate | plan | run)
    run_export_command cli selectors
    ;;
  password)
    run_password_command cli
    ;;
  *)
    usage >&2
    exit 1
    ;;
  esac
}

main "$@"
